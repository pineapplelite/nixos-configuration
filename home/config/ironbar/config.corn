let {
	// -- start --

	$focused_window = {
		name = "topbar-focused_window"
		type = "focused"

		truncate.mode = "end"
		truncate.max_length = 13
		icon_size = 16
	}

	// -- center --

	$workspaces = {
		name = "topbar-workspaces"
		type = "workspaces"
	}

	// -- end --

	$keyboard_layout = {
		name = "topbar-keyboard_layout"
		type = "script"

		cmd = "niri msg -j keyboard-layouts | jq -r '.names[.current_idx] | .[0:2] | ascii_downcase'"
		interval = 100

		on_click_left = "niri msg action switch-layout next"
		on_click_right = "niri msg action switch-layout prev"
	}

	$battery = {
		name = "topbar-battery"
		type = "battery"
	}

	$tray = {
		name = "topbar-tray"
		type = "tray"

		on_click_left = "menu"
		on_click_right = "none"
	}

	$clock = {
		name = "topbar-clock"
		type = "clock"

		format = "%Y-%m-%d %H:%M"
	}
} in {
	monitors.eDP-1 = [
		{
			name = "topbar"
			position = "top"

			margin.left = 6
			margin.right = 6

			popup_autohide = true
			popup_gap = 18

			start = [ $focused_window ]
			center = [ $workspaces ]
			end = [ $keyboard_layout $battery $tray $clock ]
		}
	]
}
